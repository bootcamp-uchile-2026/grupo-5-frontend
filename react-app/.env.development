# La app llama a la API en /api, en su propio origen, y Vite reenvía esas
# llamadas a API_DESTINO (proxy en vite.config.ts). Así el navegador trata la
# API como el mismo sitio y guarda las cookies HttpOnly de la sesión.
# La URL de la API es pública (Swagger: http://3.131.220.134:3000/docs) y este
# archivo se sube al repositorio para que la app use los datos reales al clonarla (pnpm dev).
# Para trabajar con los datos de prueba, ver .env.example.
VITE_API_URL=/api
API_DESTINO=http://3.131.220.134:3000
